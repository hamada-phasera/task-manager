# このファイルを .env にコピーして、自分のキーを書き込む
# cp .env.example .env

# Discord Developer Portal > Bot > Reset Token で取得
DISCORD_TOKEN=ここにDiscordボットのトークン

# Google AI Studio (https://aistudio.google.com/apikey) で取得
GEMINI_API_KEY=ここにGeminiのAPIキー

# (任意) テスト用サーバーのID。右クリック→「サーバーIDをコピー」
# 指定するとスラッシュコマンドがすぐ使えるようになる
GUILD_ID=
